APP_NAME=WatchKru
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8787
APP_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=watchkru
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:1258
SESSION_DOMAIN=localhost

FRONTEND_URL=http://localhost:1258
CORS_ALLOWED_ORIGINS="http://localhost:1258,http://127.0.0.1:1258"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@watchkru.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional external metadata provider. The app must work with these unset.
TMDB_API_KEY=
TMDB_ENABLED=false
